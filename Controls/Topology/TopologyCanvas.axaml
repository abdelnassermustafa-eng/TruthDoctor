<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TruthDoctor.Controls.Topology.TopologyCanvas">

    <Border
        Background="#0F172A"
        BorderBrush="#1E293B"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,*">

            <Border
                Grid.Row="0"
                Padding="12,9"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="8">

                    <Button
                        Grid.Column="0"
                        Name="TopologyBackButton"
                        Content="←  Back"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyBackButton_OnClick"/>

                    <Button
                        Grid.Column="1"
                        Name="TopologyForwardButton"
                        Content="Forward  →"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyForwardButton_OnClick"/>

                    <Button
                        Grid.Column="2"
                        Name="TopologyHomeButton"
                        Content="⌂  Home"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyHomeButton_OnClick"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="Depth"
                        Foreground="#7F9AB8"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Column="4"
                        Name="TopologyDepthComboBox"
                        Width="92"
                        SelectedIndex="1"
                        SelectionChanged="TopologyDepthComboBox_OnSelectionChanged">

                        <ComboBoxItem
                            Content="1 hop"
                            Tag="1"/>

                        <ComboBoxItem
                            Content="2 hops"
                            Tag="2"/>

                        <ComboBoxItem
                            Content="3 hops"
                            Tag="3"/>
                    </ComboBox>

                    <TextBlock
                        Grid.Column="6"
                        Text="View"
                        Foreground="#7F9AB8"
                        VerticalAlignment="Center"/>

                    <Button
                        Grid.Column="7"
                        Name="TopologyZoomOutButton"
                        Content="−"
                        Width="36"
                        Padding="8,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyZoomOutButton_OnClick"/>

                    <Button
                        Grid.Column="8"
                        Name="TopologyResetZoomButton"
                        Content="100%"
                        MinWidth="62"
                        Padding="10,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyResetZoomButton_OnClick"/>

                    <Button
                        Grid.Column="9"
                        Name="TopologyZoomInButton"
                        Content="+"
                        Width="36"
                        Padding="8,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyZoomInButton_OnClick"/>

                    <Button
                        Grid.Column="10"
                        Name="TopologyFitButton"
                        Content="Fit"
                        Padding="12,6"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderBrush="#3B82F6"
                        Click="TopologyFitButton_OnClick"/>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="10,6"
                Background="#0D1B30"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="5">

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="13"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Relationships"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>

                        <CheckBox
                            Name="AllRelationshipFilter"
                            Content="All"
                            IsChecked="True"
                            Foreground="#CBD5E1"
                            Click="AllRelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="ContainmentFilter"
                            Content="Containment"
                            IsChecked="True"
                            Foreground="#A78BFA"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="PlacementFilter"
                            Content="Placement"
                            IsChecked="True"
                            Foreground="#60A5FA"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="DependencyFilter"
                            Content="Dependency"
                            IsChecked="True"
                            Foreground="#FBBF24"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="ConnectivityFilter"
                            Content="Connectivity"
                            IsChecked="True"
                            Foreground="#22D3EE"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="SecurityFilter"
                            Content="Security"
                            IsChecked="True"
                            Foreground="#FB7185"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="TrafficFilter"
                            Content="Traffic"
                            IsChecked="True"
                            Foreground="#34D399"
                            Click="RelationshipFilter_OnClick"/>
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                        ColumnSpacing="13">

                        <CheckBox
                            Grid.Column="0"
                            Name="AssociationFilter"
                            Content="Association"
                            IsChecked="True"
                            Foreground="#C084FC"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Grid.Column="1"
                            Name="OtherFilter"
                            Content="Other"
                            IsChecked="True"
                            Foreground="#94A3B8"
                            Click="RelationshipFilter_OnClick"/>

                        <TextBlock
                            Grid.Column="2"
                            Name="RelationshipCountText"
                            Text="0 nodes · 0/0 edges"
                            Foreground="#7F9AB8"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="4"
                            Content="Reset"
                            Padding="10,4"
                            Background="#15263D"
                            Foreground="#E2E8F0"
                            BorderBrush="#334A68"
                            Click="ResetRelationshipFilters_OnClick"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="2"
                Name="TopologyScrollViewer"
                Padding="12"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Canvas
                    Name="TopologySurface"
                    Width="1600"
                    Height="1000">

                    <Canvas
                        Name="RootCanvas"
                        Width="1600"
                        Height="1000"/>
                </Canvas>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
