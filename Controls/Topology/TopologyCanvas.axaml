<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TruthDoctor.Controls.Topology.TopologyCanvas">

    <Border
        Background="#0F172A"
        BorderBrush="#1E293B"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,*">

            <Border
                Grid.Row="0"
                Padding="12,9"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      ColumnSpacing="8">

                    <Button
                        Grid.Column="0"
                        Name="TopologyBackButton"
                        Content="←  Back"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyBackButton_OnClick"/>

                    <Button
                        Grid.Column="1"
                        Name="TopologyForwardButton"
                        Content="Forward  →"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyForwardButton_OnClick"/>

                    <Button
                        Grid.Column="2"
                        Name="TopologyHomeButton"
                        Content="⌂  Home"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyHomeButton_OnClick"/>

                    <TextBlock
                        Grid.Column="4"
                        Text="Click a resource to explore"
                        Foreground="#7F9AB8"
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                Padding="12"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Canvas
                    x:Name="RootCanvas"
                    Width="1600"
                    Height="1000"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
