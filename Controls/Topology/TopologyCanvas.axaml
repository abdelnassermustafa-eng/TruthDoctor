<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TruthDoctor.Controls.Topology.TopologyCanvas">

    <Border
        Background="#0F172A"
        BorderBrush="#1E293B"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12">

        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">

            <Canvas
                x:Name="RootCanvas"
                Width="1600"
                Height="1000"/>
        </ScrollViewer>
    </Border>
</UserControl>
