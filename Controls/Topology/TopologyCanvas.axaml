<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TruthDoctor.Controls.Topology.TopologyCanvas">

    <!-- F4 scoped topology action presentation. -->
    <UserControl.Styles>
        <Style Selector="Button.td-topology-teal:pointerover">
            <Setter Property="Background" Value="#115E59"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-topology-teal:pressed">
            <Setter Property="Background" Value="#134E4A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-topology-teal:disabled">
            <Setter Property="Background" Value="#DCE8E5"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.td-topology-teal:disabled:pointerover">
            <Setter Property="Background" Value="#DCE8E5"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.td-topology-teal:focus-visible">
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.td-topology-teal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#115E59"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-topology-teal:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#134E4A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-topology-teal:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE8E5"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.td-topology-teal:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE8E5"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- F5.3: only the relationship flyout may
             exceed Fluent's default presenter width. -->
        <Style Selector="FlyoutPresenter.td-relationship-wide">
            <Setter Property="MaxWidth" Value="1200"/>
        </Style>

        <!-- F6.2: readable secondary toolbar states,
             scoped to the Topology canvas only. -->
        <Style Selector="Button.td-topology-secondary">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:pointerover">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:pressed">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:focus-visible">
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:disabled">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:disabled:pointerover">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-secondary:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- F6.4-D: preserve the right-action teal
             hierarchy even while Clear path is disabled.
             The command remains disabled until a path
             exists; this style changes appearance only. -->
        <Style Selector="Button.td-topology-teal.td-topology-clear-path:disabled">
            <Setter Property="Background" Value="#115E59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#14B8A6"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-teal.td-topology-clear-path:disabled:pointerover">
            <Setter Property="Background" Value="#115E59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#14B8A6"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-teal.td-topology-clear-path:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#115E59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.td-topology-teal.td-topology-clear-path:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#115E59"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </UserControl.Styles>


    <Border
        Background="#0F172A"
        BorderBrush="#1E293B"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

            <Border
                Grid.Row="0"
                Padding="12,9"
                Background="{DynamicResource TD.SurfaceBrush}"
                BorderBrush="{DynamicResource TD.BorderBrush}"
                BorderThickness="0,0,0,1">

                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
<StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="0,0,4,0">
<Button AutomationProperties.Name="Back — previous topology view" ToolTip.Tip="Back — previous topology view" Height="32" Width="40"
                        Margin="0,0,6,8"
                        Name="TopologyBackButton"
                        Content="←"
                        IsEnabled="False"
                        Padding="8,5"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        Click="TopologyBackButton_OnClick"/>
<Button AutomationProperties.Name="Forward — next topology view" ToolTip.Tip="Forward — next topology view" Height="32" Width="40"
                        Margin="0,0,6,8"
                        Name="TopologyForwardButton"
                        Content="→"
                        IsEnabled="False"
                        Padding="8,5"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        Click="TopologyForwardButton_OnClick"/>
<Button AutomationProperties.Name="Home — topology overview" ToolTip.Tip="Home — topology overview" Height="32" Width="40"
                        Margin="0,0,6,8"
                        Name="TopologyHomeButton"
                        Content="⌂"
                        IsEnabled="False"
                        Padding="8,5"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        Click="TopologyHomeButton_OnClick"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="0,0,4,0">
<TextBlock
                        Margin="0,0,8,8"
                        Text="Depth"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        VerticalAlignment="Center"/>
<ComboBox
                        Margin="0,0,8,8"
                        Name="TopologyDepthComboBox"
                        Width="92"
                        SelectedIndex="1"
                        SelectionChanged="TopologyDepthComboBox_OnSelectionChanged">

                        <ComboBoxItem
                            Content="1 hop"
                            Tag="1"/>

                        <ComboBoxItem
                            Content="2 hops"
                            Tag="2"/>

                        <ComboBoxItem
                            Content="3 hops"
                            Tag="3"/>
                    </ComboBox>
<StackPanel Margin="0,0,8,8" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <ComboBox x:Name="TopologyScopeComboBox" Width="180" SelectedIndex="1" >
                            <ComboBoxItem Content="Full Infrastructure"/>
                            <ComboBoxItem Content="Resource Neighborhood"/>
                        </ComboBox>
                    <TextBlock

                        Name="TopologyExportStatusText"
                        Text=""
                        MaxWidth="230"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
                    </StackPanel>
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="0,0,4,0">
<TextBlock
                        Margin="0,0,8,8"
                        Text="View"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        VerticalAlignment="Center"/>
<Button
                        Margin="0,0,8,8"
                        Name="TopologyZoomOutButton"
                        Content="−"
                        Width="36"
                        Padding="8,6"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        Click="TopologyZoomOutButton_OnClick"/>
<Button
                        Margin="0,0,8,8"
                        Name="TopologyResetZoomButton"
                        Content="100%"
                        MinWidth="62"
                        Padding="10,6"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        Click="TopologyResetZoomButton_OnClick"/>
<Button
                        Margin="0,0,8,8"
                        Name="TopologyZoomInButton"
                        Content="+"
                        Width="36"
                        Padding="8,6"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        Click="TopologyZoomInButton_OnClick"/>
<Button Width="66" Height="32" Classes="td-topology-teal"
                        Margin="0,0,8,8"
                        Name="TopologyFitButton"
                        Content="Fit"
                        Padding="12,5"
                        Background="#0F766E"
                        Foreground="White"
                        BorderBrush="#14B8A6"
                        Click="TopologyFitButton_OnClick"/>
</StackPanel>
</WrapPanel>
            </Border>

            <Border Grid.Row="1" Padding="10,7"
            Background="#0B1728"
            BorderBrush="#223149"
            BorderThickness="0,0,0,1">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  RowSpacing="8" ColumnSpacing="10">
                <WrapPanel Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Orientation="Horizontal">
<TextBlock Margin="0,0,8,0" Width="51"
                            Text="Find"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>
<TextBox Margin="0,0,10,0"
                            Name="TopologySearchTextBox"
                            Width="260"
                            Background="{DynamicResource TD.SurfaceBrush}"
                            Foreground="{DynamicResource TD.TextPrimaryBrush}"
                            BorderBrush="{DynamicResource TD.BorderBrush}"
                            Height="34"
                            MinWidth="120"
                            Watermark="Search this topology..."/>
<Button Margin="0,0,10,0" Classes="td-topology-secondary"
                            Name="TopologyPreviousMatchButton"
                            Content="← Previous"
                            IsEnabled="False"
                            Padding="10,5"
                            Click="TopologyPreviousMatchButton_OnClick" Width="100" Height="32"/>
<Button Margin="0,0,10,0" Classes="td-topology-secondary"
                            Name="TopologyNextMatchButton"
                            Content="Next →"
                            IsEnabled="False"
                            Padding="10,5"
                            Click="TopologyNextMatchButton_OnClick" Width="100" Height="32"/>
<TextBlock
                            Name="TopologySearchStatusText"
                            Text=""
                            MinWidth="105"
                            MaxWidth="170"
                            TextTrimming="CharacterEllipsis"
                            Foreground="#7F9AB8"
                            VerticalAlignment="Center"/>
<Button Classes="td-topology-secondary"
                            Name="TopologyClearSearchButton"
                            Content="Clear"
                            IsEnabled="False"
                            Padding="10,5"
                            Click="TopologyClearSearchButton_OnClick"/>
                </WrapPanel>
<Button Grid.Column="2" Grid.Row="0" Width="100" Height="32" Classes="td-topology-teal"
                        Name="TopologyExportButton"
                        Content="Export ▾"
                        Padding="12,5"
                        Background="#0F766E"
                        Foreground="White"
                        BorderBrush="#14B8A6">

                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Header="PNG snapshot…"
                                    Click="TopologyExportPngMenuItem_OnClick"/>

                                <MenuItem
                                    Header="JSON topology…"
                                    Click="TopologyExportJsonMenuItem_OnClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                <StackPanel Grid.Row="1" Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
<TextBlock
                            Text="Domain"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>
<ComboBox
                            Name="TopologyDomainComboBox"
                            Background="{DynamicResource TD.SurfaceBrush}"
                            Foreground="{DynamicResource TD.TextPrimaryBrush}"
                            BorderBrush="{DynamicResource TD.BorderBrush}"
                            Width="260"
                            IsEnabled="False">
                            <ComboBox.Resources>
                                <SolidColorBrush
                                    x:Key="ComboBoxBackgroundDisabled"
                                    Color="#F1F5F9"/>
                                <SolidColorBrush
                                    x:Key="ComboBoxForegroundDisabled"
                                    Color="#334155"/>
                                <SolidColorBrush
                                    x:Key="ComboBoxBorderBrushDisabled"
                                    Color="#94A3B8"/>
                                <SolidColorBrush
                                    x:Key="ComboBoxDropDownGlyphForegroundDisabled"
                                    Color="#475569"/>
                            </ComboBox.Resources>
                        </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,0" Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">
<TextBlock
                            Text="Layout"
                            Foreground="#7F9AB8"
                            VerticalAlignment="Center"/>
<ComboBox
                            Name="TopologyLayoutComboBox"
                            Background="{DynamicResource TD.SurfaceBrush}"
                            Foreground="{DynamicResource TD.TextPrimaryBrush}"
                            BorderBrush="{DynamicResource TD.BorderBrush}"
                            Width="136"
                            SelectedIndex="0">

                            <ComboBoxItem
                                Content="Radial"
                                Tag="Radial"/>

                            <ComboBoxItem
                                Content="Hierarchy"
                                Tag="Hierarchical"/>

                            <ComboBoxItem
                                Content="Network"
                                Tag="Network"/>

                            <ComboBoxItem
                                Content="Domains"
                                Tag="Domain"/>
                        </ComboBox>
                </StackPanel>
<Button Grid.Column="2" Grid.Row="1" Width="100" Height="32" Classes="td-topology-teal"
                            Name="TopologyArrangeButton"
                            Content="Arrange"
                            Padding="12,5"
                            Background="#0F766E"
                            Foreground="White"
                            BorderBrush="#14B8A6"
                            Click="TopologyArrangeButton_OnClick"/>
            </Grid>
        </Border>

            <Border Grid.Row="2" Padding="10,7"
            Background="#0B1728"
            BorderBrush="#223149"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="90,209,0,100,100,*,100"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10">
<TextBlock Grid.Column="0" Grid.Row="0"


                        Text="Saved views"
                        FontWeight="SemiBold"
                        Foreground="#E2E8F0"
                        VerticalAlignment="Center"/>
<ComboBox Grid.Column="1" Grid.Row="0"


                        Name="TopologySavedViewComboBox"
                        Background="{DynamicResource TD.SurfaceBrush}"
                        Foreground="{DynamicResource TD.TextPrimaryBrush}"
                        BorderBrush="{DynamicResource TD.BorderBrush}"
                        MinWidth="180"
                        MaxDropDownHeight="320"
                        SelectionChanged="TopologySavedViewComboBox_OnSelectionChanged" Width="209">

                        <ComboBoxItem
                            Content="Select a saved view..."
                            Tag=""
                            IsEnabled="False"/>
                    </ComboBox>
<TextBlock Grid.Column="5" Grid.Row="0" MaxWidth="150"



                        Name="TopologySavedViewStatusText"
                        Text="No saved views"
                        Foreground="#7F9AB8"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"/>
<Button Classes="td-topology-secondary" Grid.Column="3" Grid.Row="0"


                        Name="TopologyLoadViewButton"
                        Content="Load"
                        MinWidth="68"
                        Padding="12,5"
                        IsEnabled="False"
                        Click="TopologyLoadViewButton_OnClick" Width="100" Height="32"/>
<Button Classes="td-topology-secondary" Grid.Column="4" Grid.Row="0"


                        Name="TopologyManageViewButton"
                        Content="Manage ▾"
                        MinWidth="86"
                        Padding="12,5"
                        IsEnabled="False" Width="100" Height="32">

                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Name="TopologyRenameViewMenuItem"
                                    Header="Rename…"
                                    Click="TopologyRenameViewMenuItem_OnClick"/>

                                <Separator/>

                                <MenuItem
                                    Name="TopologyDeleteViewMenuItem"
                                    Header="Delete…"
                                    Click="TopologyDeleteViewMenuItem_OnClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
<Button Grid.Column="6" Grid.Row="0" Width="100" Height="32" Classes="td-topology-teal"


                        Name="TopologySaveViewButton"
                        Content="Save view"
                        Padding="12,5"
                        Background="#0F766E"
                        Foreground="White"
                        BorderBrush="#14B8A6"
                        Click="TopologySaveViewButton_OnClick"/>
<TextBlock IsVisible="False" Grid.Column="2" Grid.Row="1"


                        Name="TopologySavedViewCountText"
                        Text="0"
                        MinWidth="24"
                        Padding="7,2"
                        Background="#15263D"
                        Foreground="#BAE6FD"
                        TextAlignment="Center"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

            <Border
                Grid.Row="3"
                Padding="10,7"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="8">

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="88,Auto,*,Auto"
                        ColumnSpacing="8">

                        <TextBlock
                            Grid.Column="0"
                            Text="Path"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>

                        <Button Height="32" Classes="td-topology-teal"
                            Grid.Column="1"
                            Name="TopologyStartPathButton"
                            Content="Start path"
                            Padding="12,5"
                            Background="#0F766E"
                            Foreground="White"
                            BorderBrush="#14B8A6"
                            Click="TopologyStartPathButton_OnClick"/>

                        <TextBlock
                            Grid.Column="2"
                            Name="TopologyPathStatusText"
                            Text="Center a source resource, then start a path"
                            Foreground="#7F9AB8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>

                        <Button ToolTip.Tip="Clear the current path when one exists" BorderBrush="#14B8A6" Foreground="White" Background="#0F766E" Width="100" MinWidth="100" Height="32" Classes="td-topology-teal td-topology-clear-path"
                            Grid.Column="3"
                            Name="TopologyClearPathButton"
                            Content="Clear path"
                            IsEnabled="False"
                            Padding="12,5"
                            Click="TopologyClearPathButton_OnClick"/>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Name="TopologyPathDetailsCard"
                        IsVisible="False"
                        Padding="10"
                        CornerRadius="8"
                        Background="#101F35"
                        BorderBrush="#2C4668"
                        BorderThickness="1">

                        <StackPanel Spacing="8">

                            <TextBlock
                                Name="TopologyPathDetailsSummaryText"
                                FontWeight="SemiBold"
                                Foreground="#E2E8F0"
                                TextWrapping="Wrap"/>

                            <StackPanel
                                Name="TopologyPathDetailsPanel"
                                Spacing="5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4" Padding="10,6"
            Background="{DynamicResource TD.SurfaceBrush}"
            BorderBrush="{DynamicResource TD.BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="10"
                  VerticalAlignment="Center">
<Button Grid.Column="0"
                            Name="TopologyRelationshipFiltersButton"
                            Classes="td-secondary"
                            Content="Relationships  ▾"
                            Padding="14,7"
                            Background="#FFFFFF"
                            Foreground="#0F172A"
                            BorderBrush="#CBD5E1"><Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="td-relationship-wide">
                <Border Padding="12,10"
                        Background="#FFFFFF"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
<CheckBox
                            Name="AllRelationshipFilter"
                            Content="All"
                            IsChecked="True"
                            Foreground="#334155"
                            Click="AllRelationshipFilter_OnClick"/>
<CheckBox
                            Name="ContainmentFilter"
                            Content="Containment"
                            IsChecked="True"
                            Foreground="#6D28D9"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox
                            Name="PlacementFilter"
                            Content="Placement"
                            IsChecked="True"
                            Foreground="#1D4ED8"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox
                            Name="DependencyFilter"
                            Content="Dependency"
                            IsChecked="True"
                            Foreground="#92400E"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox
                            Name="ConnectivityFilter"
                            Content="Connectivity"
                            IsChecked="True"
                            Foreground="#0E7490"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox
                            Name="SecurityFilter"
                            Content="Security"
                            IsChecked="True"
                            Foreground="#BE123C"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox
                            Name="TrafficFilter"
                            Content="Traffic"
                            IsChecked="True"
                            Foreground="#047857"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox

                            Name="AssociationFilter"
                            Content="Association"
                            IsChecked="True"
                            Foreground="#7E22CE"
                            Click="RelationshipFilter_OnClick"/>
<CheckBox

                            Name="OtherFilter"
                            Content="Other"
                            IsChecked="True"
                            Foreground="#475569"
                            Click="RelationshipFilter_OnClick"/>
                    </StackPanel>
                </Border>
            </Flyout>
        </Button.Flyout></Button>
<Button Grid.Column="1" Grid.Row="0" Height="32" Classes="td-secondary"

                            Content="Reset"
                            Padding="12,5"
                            Background="#FFFFFF"
                            Foreground="#0F172A"
                            BorderBrush="#CBD5E1"
                            Click="ResetRelationshipFilters_OnClick"/>
<TextBlock HorizontalAlignment="Right" Grid.Column="3" Grid.Row="0"

                            Name="RelationshipCountText"
                            Text="0 nodes · 0/0 edges"
                            Foreground="#64748B"
                            VerticalAlignment="Center"/>
            </Grid>
        </Border>

            <Grid
                Grid.Row="5">

                <ScrollViewer
                    Name="TopologyScrollViewer"
                    Padding="12"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <Canvas
                        Name="TopologySurface"
                        Width="1600"
                        Height="1000">

                        <Canvas
                            Name="RootCanvas"
                            Width="1600"
                            Height="1000"/>
                    </Canvas>
                </ScrollViewer>

                <Border
                    Name="TopologyMinimapPanel"
                    Width="252"
                    Height="184"
                    Margin="0,0,24,24"
                    Padding="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#F20B1728"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 8 22 0 #99000000">

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="8">

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="7">

                                <TextBlock
                                    Text="◈"
                                    Foreground="#38BDF8"
                                    FontSize="13"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Minimap"
                                    Foreground="#E2E8F0"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="Hide"
                                Padding="8,2"
                                Background="#15263D"
                                Foreground="#94A3B8"
                                BorderBrush="#334A68"
                                Click="TopologyHideMinimapButton_OnClick"/>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="#07111F"
                            BorderBrush="#223149"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">

                            <Canvas
                                Name="TopologyMinimapSurface"
                                Width="228"
                                Height="140"
                                Background="Transparent">

                                <Canvas
                                    Name="TopologyMinimapContent"
                                    Width="228"
                                    Height="140"
                                    IsHitTestVisible="False"/>

                                <Rectangle
                                    Name="TopologyMinimapViewport"
                                    Width="40"
                                    Height="30"
                                    Fill="#2438BDF8"
                                    Stroke="#38BDF8"
                                    StrokeThickness="2"
                                    IsHitTestVisible="False"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>

                <Button
                    Name="TopologyShowMinimapButton"
                    Content="◈  Map"
                    IsVisible="False"
                    Margin="0,0,24,24"
                    Padding="11,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#15263D"
                    Foreground="#BAE6FD"
                    BorderBrush="#3B82F6"
                    Click="TopologyShowMinimapButton_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
