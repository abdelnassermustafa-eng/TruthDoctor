<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TruthDoctor.Controls.Topology.TopologyCanvas">

    <Border
        Background="#0F172A"
        BorderBrush="#1E293B"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <Border
                Grid.Row="0"
                Padding="12,9"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="8">

                    <Button
                        Grid.Column="0"
                        Name="TopologyBackButton"
                        Content="←  Back"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyBackButton_OnClick"/>

                    <Button
                        Grid.Column="1"
                        Name="TopologyForwardButton"
                        Content="Forward  →"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyForwardButton_OnClick"/>

                    <Button
                        Grid.Column="2"
                        Name="TopologyHomeButton"
                        Content="⌂  Home"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyHomeButton_OnClick"/>

                    <TextBlock
                        Grid.Column="3"
                        Text="Depth"
                        Foreground="#7F9AB8"
                        VerticalAlignment="Center"/>

                    <ComboBox
                        Grid.Column="4"
                        Name="TopologyDepthComboBox"
                        Width="92"
                        SelectedIndex="1"
                        SelectionChanged="TopologyDepthComboBox_OnSelectionChanged">

                        <ComboBoxItem
                            Content="1 hop"
                            Tag="1"/>

                        <ComboBoxItem
                            Content="2 hops"
                            Tag="2"/>

                        <ComboBoxItem
                            Content="3 hops"
                            Tag="3"/>
                    </ComboBox>

                    <TextBlock
                        Grid.Column="5"
                        Name="TopologyExportStatusText"
                        Text=""
                        MaxWidth="230"
                        TextTrimming="CharacterEllipsis"
                        Foreground="#7F9AB8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

                    <TextBlock
                        Grid.Column="6"
                        Text="View"
                        Foreground="#7F9AB8"
                        VerticalAlignment="Center"/>

                    <Button
                        Grid.Column="7"
                        Name="TopologyZoomOutButton"
                        Content="−"
                        Width="36"
                        Padding="8,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyZoomOutButton_OnClick"/>

                    <Button
                        Grid.Column="8"
                        Name="TopologyResetZoomButton"
                        Content="100%"
                        MinWidth="62"
                        Padding="10,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyResetZoomButton_OnClick"/>

                    <Button
                        Grid.Column="9"
                        Name="TopologyZoomInButton"
                        Content="+"
                        Width="36"
                        Padding="8,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyZoomInButton_OnClick"/>

                    <Button
                        Grid.Column="10"
                        Name="TopologyFitButton"
                        Content="Fit"
                        Padding="12,6"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderBrush="#3B82F6"
                        Click="TopologyFitButton_OnClick"/>

                    <Button
                        Grid.Column="11"
                        Name="TopologyExportButton"
                        Content="Export ▾"
                        Padding="12,6"
                        Background="#0F766E"
                        Foreground="White"
                        BorderBrush="#14B8A6">

                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Header="PNG snapshot…"
                                    Click="TopologyExportPngMenuItem_OnClick"/>

                                <MenuItem
                                    Header="JSON topology…"
                                    Click="TopologyExportJsonMenuItem_OnClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="10,7"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="7">

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto"
                        ColumnSpacing="8">

                        <TextBlock
                            Grid.Column="0"
                            Text="Find"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>

                        <TextBox
                            Grid.Column="1"
                            Name="TopologySearchTextBox"
                            Height="34"
                            MinWidth="120"
                            MaxWidth="520"
                            HorizontalAlignment="Stretch"
                            Watermark="Search this topology..."/>

                        <Button
                            Grid.Column="2"
                            Name="TopologyPreviousMatchButton"
                            Content="← Previous"
                            IsEnabled="False"
                            Padding="10,5"
                            Background="#15263D"
                            Foreground="#E2E8F0"
                            BorderBrush="#334A68"
                            Click="TopologyPreviousMatchButton_OnClick"/>

                        <Button
                            Grid.Column="3"
                            Name="TopologyNextMatchButton"
                            Content="Next →"
                            IsEnabled="False"
                            Padding="10,5"
                            Background="#15263D"
                            Foreground="#E2E8F0"
                            BorderBrush="#334A68"
                            Click="TopologyNextMatchButton_OnClick"/>

                        <TextBlock
                            Grid.Column="4"
                            Name="TopologySearchStatusText"
                            Text="Search current graph"
                            MinWidth="105"
                            MaxWidth="170"
                            TextTrimming="CharacterEllipsis"
                            Foreground="#7F9AB8"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="5"
                            Name="TopologyClearSearchButton"
                            Content="Clear"
                            IsEnabled="False"
                            Padding="10,5"
                            Background="#15263D"
                            Foreground="#E2E8F0"
                            BorderBrush="#334A68"
                            Click="TopologyClearSearchButton_OnClick"/>
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                        ColumnSpacing="8">

                        <TextBlock
                            Grid.Column="0"
                            Text="Domain"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>

                        <ComboBox
                            Grid.Column="1"
                            Name="TopologyDomainComboBox"
                            Width="180"
                            IsEnabled="False"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Layout"
                            Foreground="#7F9AB8"
                            VerticalAlignment="Center"/>

                        <ComboBox
                            Grid.Column="4"
                            Name="TopologyLayoutComboBox"
                            Width="136"
                            SelectedIndex="0">

                            <ComboBoxItem
                                Content="Radial"
                                Tag="Radial"/>

                            <ComboBoxItem
                                Content="Hierarchy"
                                Tag="Hierarchical"/>

                            <ComboBoxItem
                                Content="Network"
                                Tag="Network"/>

                            <ComboBoxItem
                                Content="Domains"
                                Tag="Domain"/>
                        </ComboBox>

                        <Button
                            Grid.Column="5"
                            Name="TopologyArrangeButton"
                            Content="Arrange"
                            Padding="11,5"
                            Background="#0F766E"
                            Foreground="White"
                            BorderBrush="#14B8A6"
                            Click="TopologyArrangeButton_OnClick"/>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="10,7"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="8">

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,Auto,*,Auto"
                        ColumnSpacing="8">

                        <TextBlock
                            Grid.Column="0"
                            Text="Path"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="1"
                            Name="TopologyStartPathButton"
                            Content="Start path"
                            Padding="12,5"
                            Background="#1D4ED8"
                            Foreground="White"
                            BorderBrush="#3B82F6"
                            Click="TopologyStartPathButton_OnClick"/>

                        <TextBlock
                            Grid.Column="2"
                            Name="TopologyPathStatusText"
                            Text="Center a source resource, then start a path"
                            Foreground="#7F9AB8"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="3"
                            Name="TopologyClearPathButton"
                            Content="Clear path"
                            IsEnabled="False"
                            Padding="10,5"
                            Background="#15263D"
                            Foreground="#E2E8F0"
                            BorderBrush="#334A68"
                            Click="TopologyClearPathButton_OnClick"/>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Name="TopologyPathDetailsCard"
                        IsVisible="False"
                        Padding="10"
                        CornerRadius="8"
                        Background="#101F35"
                        BorderBrush="#2C4668"
                        BorderThickness="1">

                        <StackPanel Spacing="8">

                            <TextBlock
                                Name="TopologyPathDetailsSummaryText"
                                FontWeight="SemiBold"
                                Foreground="#E2E8F0"
                                TextWrapping="Wrap"/>

                            <StackPanel
                                Name="TopologyPathDetailsPanel"
                                Spacing="5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Row="3"
                Padding="10,6"
                Background="#0D1B30"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    RowDefinitions="Auto,Auto"
                    RowSpacing="5">

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="13"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Relationships"
                            FontWeight="SemiBold"
                            Foreground="#E2E8F0"
                            VerticalAlignment="Center"/>

                        <CheckBox
                            Name="AllRelationshipFilter"
                            Content="All"
                            IsChecked="True"
                            Foreground="#CBD5E1"
                            Click="AllRelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="ContainmentFilter"
                            Content="Containment"
                            IsChecked="True"
                            Foreground="#A78BFA"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="PlacementFilter"
                            Content="Placement"
                            IsChecked="True"
                            Foreground="#60A5FA"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="DependencyFilter"
                            Content="Dependency"
                            IsChecked="True"
                            Foreground="#FBBF24"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="ConnectivityFilter"
                            Content="Connectivity"
                            IsChecked="True"
                            Foreground="#22D3EE"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="SecurityFilter"
                            Content="Security"
                            IsChecked="True"
                            Foreground="#FB7185"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Name="TrafficFilter"
                            Content="Traffic"
                            IsChecked="True"
                            Foreground="#34D399"
                            Click="RelationshipFilter_OnClick"/>
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                        ColumnSpacing="13">

                        <CheckBox
                            Grid.Column="0"
                            Name="AssociationFilter"
                            Content="Association"
                            IsChecked="True"
                            Foreground="#C084FC"
                            Click="RelationshipFilter_OnClick"/>

                        <CheckBox
                            Grid.Column="1"
                            Name="OtherFilter"
                            Content="Other"
                            IsChecked="True"
                            Foreground="#94A3B8"
                            Click="RelationshipFilter_OnClick"/>

                        <TextBlock
                            Grid.Column="2"
                            Name="RelationshipCountText"
                            Text="0 nodes · 0/0 edges"
                            Foreground="#7F9AB8"
                            VerticalAlignment="Center"/>

                        <Button
                            Grid.Column="4"
                            Content="Reset"
                            Padding="10,4"
                            Background="#15263D"
                            Foreground="#E2E8F0"
                            BorderBrush="#334A68"
                            Click="ResetRelationshipFilters_OnClick"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid
                Grid.Row="4">

                <ScrollViewer
                    Name="TopologyScrollViewer"
                    Padding="12"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">

                    <Canvas
                        Name="TopologySurface"
                        Width="1600"
                        Height="1000">

                        <Canvas
                            Name="RootCanvas"
                            Width="1600"
                            Height="1000"/>
                    </Canvas>
                </ScrollViewer>

                <Border
                    Name="TopologyMinimapPanel"
                    Width="252"
                    Height="184"
                    Margin="0,0,24,24"
                    Padding="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#F20B1728"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    CornerRadius="8"
                    BoxShadow="0 8 22 0 #99000000">

                    <Grid
                        RowDefinitions="Auto,*"
                        RowSpacing="8">

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="7">

                                <TextBlock
                                    Text="◈"
                                    Foreground="#38BDF8"
                                    FontSize="13"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Minimap"
                                    Foreground="#E2E8F0"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Content="Hide"
                                Padding="8,2"
                                Background="#15263D"
                                Foreground="#94A3B8"
                                BorderBrush="#334A68"
                                Click="TopologyHideMinimapButton_OnClick"/>
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Background="#07111F"
                            BorderBrush="#223149"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True">

                            <Canvas
                                Name="TopologyMinimapSurface"
                                Width="228"
                                Height="140"
                                Background="Transparent">

                                <Canvas
                                    Name="TopologyMinimapContent"
                                    Width="228"
                                    Height="140"
                                    IsHitTestVisible="False"/>

                                <Rectangle
                                    Name="TopologyMinimapViewport"
                                    Width="40"
                                    Height="30"
                                    Fill="#2438BDF8"
                                    Stroke="#38BDF8"
                                    StrokeThickness="2"
                                    IsHitTestVisible="False"/>
                            </Canvas>
                        </Border>
                    </Grid>
                </Border>

                <Button
                    Name="TopologyShowMinimapButton"
                    Content="◈  Map"
                    IsVisible="False"
                    Margin="0,0,24,24"
                    Padding="11,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#15263D"
                    Foreground="#BAE6FD"
                    BorderBrush="#3B82F6"
                    Click="TopologyShowMinimapButton_OnClick"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
