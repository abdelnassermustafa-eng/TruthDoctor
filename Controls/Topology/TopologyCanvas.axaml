<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TruthDoctor.Controls.Topology.TopologyCanvas">

    <Border
        Background="#0F172A"
        BorderBrush="#1E293B"
        BorderThickness="1"
        CornerRadius="8">

        <Grid RowDefinitions="Auto,*">

            <Border
                Grid.Row="0"
                Padding="12,9"
                Background="#0B1728"
                BorderBrush="#223149"
                BorderThickness="0,0,0,1">

                <Grid
                    ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="8">

                    <Button
                        Grid.Column="0"
                        Name="TopologyBackButton"
                        Content="←  Back"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyBackButton_OnClick"/>

                    <Button
                        Grid.Column="1"
                        Name="TopologyForwardButton"
                        Content="Forward  →"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyForwardButton_OnClick"/>

                    <Button
                        Grid.Column="2"
                        Name="TopologyHomeButton"
                        Content="⌂  Home"
                        IsEnabled="False"
                        Padding="12,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyHomeButton_OnClick"/>

                    <TextBlock
                        Grid.Column="4"
                        Text="View"
                        Foreground="#7F9AB8"
                        VerticalAlignment="Center"/>

                    <Button
                        Grid.Column="5"
                        Name="TopologyZoomOutButton"
                        Content="−"
                        Width="36"
                        Padding="8,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyZoomOutButton_OnClick"/>

                    <Button
                        Grid.Column="6"
                        Name="TopologyResetZoomButton"
                        Content="100%"
                        MinWidth="62"
                        Padding="10,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyResetZoomButton_OnClick"/>

                    <Button
                        Grid.Column="7"
                        Name="TopologyZoomInButton"
                        Content="+"
                        Width="36"
                        Padding="8,6"
                        Background="#15263D"
                        Foreground="#E2E8F0"
                        BorderBrush="#334A68"
                        Click="TopologyZoomInButton_OnClick"/>

                    <Button
                        Grid.Column="8"
                        Name="TopologyFitButton"
                        Content="Fit"
                        Padding="12,6"
                        Background="#1D4ED8"
                        Foreground="White"
                        BorderBrush="#3B82F6"
                        Click="TopologyFitButton_OnClick"/>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                Name="TopologyScrollViewer"
                Padding="12"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">

                <Canvas
                    Name="TopologySurface"
                    Width="1600"
                    Height="1000">

                    <Canvas
                        Name="RootCanvas"
                        Width="1600"
                        Height="1000"/>
                </Canvas>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
