<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:topology="clr-namespace:TruthDoctor.Controls.Topology"
    xmlns:controls="clr-namespace:TruthDoctor.Controls.Workbench"
    x:Class="TruthDoctor.Views.UniversalWorkbench.UniversalWorkbenchWindow"
    Title="TruthDoctor Universal Infrastructure Workbench"
    Width="1600"
    Height="960"
    MinWidth="1280"
    MinHeight="760"
    Background="#07111F">

    <Window.Styles>
        <Style Selector="Button.nav-item">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="#15263D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#243B5A"/>
        </Style>

        <Style Selector="Button.domain-item">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AFC0D5"/>
        </Style>

        <Style Selector="Button.nav-item.active">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Expander.nav-expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="96,*,30">

        <controls:WorkbenchTopBar Grid.Row="0" Name="TopBar"/>

        <Grid Grid.Row="1"
              ColumnDefinitions="290,*,370">

            <Border Grid.Column="0"
                    Background="#081525"
                    BorderBrush="#1E324C"
                    BorderThickness="0,0,1,0">

                <Grid RowDefinitions="*,Auto">

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="14,14,14,10"
                                    Spacing="3">

                            <TextBlock Text="WORKBENCH"
                                       Margin="11,4,0,9"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="1.2"
                                       Foreground="#64748B"/>
                            <Button Name="DashboardNavButton"
                                    Classes="nav-item active"
                                    Click="NavigationButton_OnClick"
                                    Tag="dashboard">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="▦"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Dashboard"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Border Margin="0,7,0,8"
                                    Padding="5"
                                    CornerRadius="10"
                                    Background="#0D1D31"
                                    BorderBrush="#1B324F"
                                    BorderThickness="1">

                                <Expander Classes="nav-expander"
                                          IsExpanded="True">

                                    <Expander.Header>
                                        <Grid ColumnDefinitions="28,*">

                                            <TextBlock Text="●"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Infrastructure"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Expander.Header>

                                    <StackPanel
                                        Name="DomainNavigationPanel"
                                        Margin="11,7,0,4"
                                        Spacing="2">

                                        <TextBlock
                                            Name="EmptyDomainsText"
                                            Margin="12,8"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="#64748B"
                                            Text="Domains appear after discovery"/>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <TextBlock Text="TOOLS"
                                       Margin="11,7,0,6"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="1.2"
                                       Foreground="#64748B"/>
                            <Button Name="ResourcesNavButton"
                                    Classes="nav-item"
                                    Click="NavigationButton_OnClick"
                                    Tag="resources">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="◇"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Resources"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Name="OperationsNavButton"
                                    Classes="nav-item"
                                    Click="NavigationButton_OnClick"
                                    Tag="operations">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="⇄"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Operations"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Name="TopologyNavButton"
                                    Classes="nav-item"
                                    Click="NavigationButton_OnClick"
                                    Tag="topology">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="◎"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Topology"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Name="HistoryNavButton"
                                    Classes="nav-item"
                                    Click="NavigationButton_OnClick"
                                    Tag="history">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="◷"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="History"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Name="ReportsNavButton"
                                    Classes="nav-item"
                                    Click="NavigationButton_OnClick"
                                    Tag="reports">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="▤"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Reports"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <Button Name="SettingsNavButton"
                                    Classes="nav-item"
                                    Click="NavigationButton_OnClick"
                                    Tag="settings">

                                <Grid ColumnDefinitions="28,*">

                                    <TextBlock Text="⚙"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Settings"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="14,10,14,14"
                            Padding="13"
                            CornerRadius="11"
                            Background="#0D223B"
                            BorderBrush="#235181"
                            BorderThickness="1">

                        <StackPanel Spacing="6">

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="DISCOVERY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           LetterSpacing="1"
                                           Foreground="#7F9AB8"/>

                                <Border Grid.Column="1"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="#4ADE80"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Name="DiscoveryStatusText"
                                       Text="Not connected"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#FBBF24"/>

                            <TextBlock Name="SidebarProviderText"
                                       Text="Provider: Unknown"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#E2E8F0"/>

                            <TextBlock Name="SidebarRefreshText"
                                       Text="Last refresh: not yet"
                                       FontSize="10"
                                       Foreground="#71849D"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" Name="DashboardWorkspace">

                <StackPanel Margin="20"
                            Spacing="14">

                    <Grid ColumnDefinitions="*,Auto">

                        <StackPanel>
                            <TextBlock Text="Infrastructure Overview"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC"/>

                            <TextBlock Text="Universal infrastructure state"
                                       Foreground="#94A3B8"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Name="LastDiscoveryText"
                                   Text="Awaiting discovery"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl Name="DomainCardsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Padding="15"
                            CornerRadius="10"
                            Background="#0D1B30"
                            BorderBrush="#263A56"
                            BorderThickness="1">

                        <Grid ColumnDefinitions="1.1*,1.4*,1.3*,Auto"
                              ColumnSpacing="12">

                            <StackPanel>
                                <TextBlock Text="Provider"
                                           FontSize="10"
                                           Foreground="#94A3B8"/>

                                <ComboBox Name="ProviderComboBox"
                                          Margin="0,5,0,0"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="Not connected"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Account / Project"
                                           FontSize="10"
                                           Foreground="#94A3B8"/>

                                <ComboBox Name="AccountComboBox"
                                          Margin="0,5,0,0"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="No account"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Location"
                                           FontSize="10"
                                           Foreground="#94A3B8"/>

                                <ComboBox Name="LocationComboBox"
                                          Margin="0,5,0,0"
                                          SelectionChanged="LocationComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="No location"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Name="RunDiscoveryButton"
                                    Content="▶  Run Discovery"
                                    Padding="20,9"
                                    Background="#2563EB"
                                    Foreground="White"
                                    VerticalAlignment="Bottom"
                                    Click="RunDiscoveryButton_OnClick"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="10"
                            Background="#0D1B30"
                            BorderBrush="#263A56"
                            BorderThickness="1">

                        <Grid RowDefinitions="Auto,*">

                            <Grid Margin="15,12"
                                  ColumnDefinitions="*,220,130,120,40"
                                  ColumnSpacing="8">

                                <TextBlock Name="ResourceTitleText"
                                           Text="Discovered Resources"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#F8FAFC"
                                           VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1"
                                         Name="ResourceSearchTextBox"
                                         Watermark="Search resources..."
                                         TextChanged="ResourceSearchTextBox_OnTextChanged"/>

                                <ComboBox Grid.Column="2"
                                          Name="DomainFilterComboBox"
                                          SelectionChanged="FilterComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="All domains"/>
                                </ComboBox>

                                <ComboBox Grid.Column="3"
                                          Name="StateFilterComboBox"
                                          SelectionChanged="FilterComboBox_OnSelectionChanged">
                                    <ComboBoxItem Content="All states"/>
                                </ComboBox>

                                <Button Grid.Column="4"
                                        Content="↻"
                                        Click="RunDiscoveryButton_OnClick"/>
                            </Grid>

                            <ListBox Grid.Row="1"
                                     Name="ResourceListBox"
                                     Margin="12"
                                     MinHeight="400"
                                     Background="#101B2C"
                                     SelectionChanged="ResourceListBox_OnSelectionChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>

            </ScrollViewer>

            <topology:TopologyCanvas
                Grid.Column="1"
                Name="TopologyWorkspace"
                IsVisible="False"/>


            <Border Grid.Column="1"
                    Name="SecondaryWorkspace"
                    Margin="18"
                    IsVisible="False"
                    CornerRadius="10"
                    Background="#0D1B30"
                    BorderBrush="#263A56"
                    BorderThickness="1">

                <Grid Margin="24"
                      RowDefinitions="Auto,Auto,Auto,*"
                      RowSpacing="12">

                    <TextBlock Name="SecondaryWorkspaceTitle"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#F8FAFC"/>

                    <TextBlock Grid.Row="1"
                               Name="SecondaryWorkspaceDescription"
                               Foreground="#94A3B8"
                               TextWrapping="Wrap"/>

                    <TextBox Grid.Row="2"
                             Name="SecondaryWorkspaceSearchTextBox"
                             IsVisible="False"
                             Watermark="Search all resources..."
                             TextChanged="SecondaryWorkspaceSearchTextBox_OnTextChanged"/>

                    <ListBox Grid.Row="3"
                             Name="SecondaryWorkspaceList"
                             MinHeight="500"
                             Background="#101B2C"
                             SelectionChanged="SecondaryWorkspaceList_OnSelectionChanged"/>
                </Grid>
            </Border>


            <Border Grid.Column="2"
                    Background="#0A1627"
                    BorderBrush="#223149"
                    BorderThickness="1,0,0,0">

                <Grid RowDefinitions="*,Auto">

                    <ScrollViewer>
                        <StackPanel Margin="14"
                                    Spacing="12">

                            <TextBlock Text="Resource Details"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"/>

                            <Border Padding="18"
                                    CornerRadius="10"
                                    Background="#0D1B30"
                                    BorderBrush="#263A56"
                                    BorderThickness="1">

                                <StackPanel Name="ResourceDetailsPanel"
                                            Spacing="8">

                                    <TextBlock Text="Select a resource to inspect its state, properties, relationships, and available operations."
                                               TextWrapping="Wrap"
                                               Foreground="#94A3B8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Margin="12"
                            Padding="14"
                            CornerRadius="12"
                            Background="#152B51"
                            BorderBrush="#2563EB"
                            BorderThickness="1">

                        <StackPanel Spacing="9">

                            <TextBlock Text="Cloud Operations Assistant"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC"/>

                            <TextBlock Name="AssistantStatusText"
                                       Text="Waiting for infrastructure state."
                                       Foreground="#BFDBFE"/>

                            <TextBox Watermark="Ask about your infrastructure..."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#2563EB"
                BorderThickness="1,1,1,0">

            <Grid Margin="14,0"
                  ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="22">

                <TextBlock Name="StatusProviderText"
                           Text="Provider: Not connected"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Name="StatusAccountText"
                           Text="Account: Unknown"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Name="StatusLocationText"
                           Text="Location: Unknown"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Name="StatusDiscoveryText"
                           Text="Discovery: Not started"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4"
                           Name="StatusApiText"
                           Text="API: Unknown"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6"
                           Name="CurrentTimeText"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
