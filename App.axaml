<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TruthDoctor.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <!-- TruthDoctor interaction roles; Fluent remains the base theme. -->
        <Style Selector="Button.td-primary:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-primary:pressed">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-primary:disabled">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.td-primary:focus-visible">
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.td-secondary:pointerover">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-secondary:pressed">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-secondary:focus-visible">
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- REQUIRED: DataGrid theme -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- D5.7-B5: Fluent ContentPresenter visual states. -->
        <Style Selector="Button.td-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E40AF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.td-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.td-primary:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>
        <Style Selector="Button.td-primary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.td-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style Selector="Button.td-secondary:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Application.Styles>

</Application>
